# Copy to env.local.sh and edit. Sourced by env.sh; everything here is optional.

# conda install to use (default: ./miniconda3 or the conda on PATH)
# export CONDA_ROOT=/path/to/miniconda3

# where setup/install_envs.sh creates the environments (default: ./envs)
# export REMOVE_ENVS=/big/disk/skeleton_envs
# GPU architectures for the pytorch3d source build (default "8.0;8.6;8.9;9.0")
# export TORCH_CUDA_ARCH_LIST="8.0"

# caches on a large disk
# export HF_HOME=/big/disk/hf_cache
# export TMPDIR=/big/disk/tmp
# export PIP_CACHE_DIR=/big/disk/pip_cache

# corporate proxy for GitHub / HuggingFace / Google Drive downloads
# export http_proxy=http://user:pass@proxy:3128
# export https_proxy=$http_proxy
# export no_proxy=127.0.0.1,localhost

# HuggingFace token (needed for the gated nvidia/Kimodo-SMPLX-RP-v1 and meta-llama/Meta-Llama-3-8B-Instruct)
# export HF_TOKEN=hf_xxx
# If Meta has not approved your account for Llama-3, point step 6 at a public re-upload of the same weights:

# model weights are downloaded by scripts/download_model_weights.sh
# export WAN_LORA_REPO=lizirulestheworld/ReMoVe   # optional official checkpoint repository
# export WAN_LORA=/path/to/step-31110.safetensors # or point directly at a local checkpoint

# External checkouts. Keep these outside the ReMoVe repository.
